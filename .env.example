# Copy to .env.local and fill in. Never commit .env.local.
# Keys: Supabase Dashboard → Project Settings → API Keys (new format, not the legacy anon/service_role JWTs).

# Frontend (public, data protected by RLS). Must start with sb_publishable_
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local only: import script, test:import, integration tests. Starts with sb_secret_. NEVER prefix with VITE_.
SUPABASE_SECRET_KEY=

# Your real account: the importer writes your data to it, check:keys looks it up. Tests never sign in with it.
LIFEHUB_EMAIL=

# Dedicated test user (separate account in Supabase Auth). e2e and test:integration sign in ONLY as this user.
# Must differ from LIFEHUB_EMAIL — tests refuse to run otherwise.
LIFEHUB_TEST_EMAIL=
LIFEHUB_TEST_PASSWORD=
