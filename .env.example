# Copy to .env.local and fill in. Never commit .env.local.
# Keys: Supabase Dashboard → Project Settings → API Keys (new format, not the legacy anon/service_role JWTs).

# Frontend (public, data protected by RLS). Must start with sb_publishable_
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local only: import script, test:import, integration tests. Starts with sb_secret_. NEVER prefix with VITE_.
SUPABASE_SECRET_KEY=

# Your account: importer finds the user by e-mail; e2e test signs in with e-mail + password.
LIFEHUB_EMAIL=
LIFEHUB_PASSWORD=
